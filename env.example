# ============================================================
#  HALAL-MEETUP API  —  Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to GitHub.
# ============================================================

# ── MS SQL Server ────────────────────────────────────────────
DB_SERVER=your-server.database.windows.net
DB_NAME=HalalMeetUp
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_PORT=1433

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Email (SendGrid) ─────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=infohalalmeetup@gmail.com
ADMIN_EMAIL=mdhelal.ahamed@gmail.com

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── File Storage (Cloudflare R2 / AWS S3) ────────────────────
STORAGE_BASE_URL=https://your-bucket.r2.dev
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET=halal-meetup-media

# ── Twilio (OTP SMS) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1xxxxxxxxxx
